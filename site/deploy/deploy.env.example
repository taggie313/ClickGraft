# Where this site is deployed. Copy to deploy.env (gitignored) and fill in.
#
#   cp site/deploy/deploy.env.example site/deploy/deploy.env
#
# Kept out of git deliberately: the host and container id describe someone's
# private network and are no use to anyone else.

# SSH target for the Proxmox node hosting the CT. Deploys go THROUGH the node,
# never into the container.
#
# Use a NODE NAME rather than an address. This is only an entry point into the
# cluster: if the container has been migrated, require_host asks the cluster
# which node holds it and follows it there, and a name is what the cluster
# answers with — so a name is what the error can tell you to set.
PVE_HOST=root@your-pve-node

# LXC container id on that node.
CT_ID=136

# Project directory inside the container.
REMOTE_DIR=/opt/edge/sites/clickgraft

# Public URL, checked after every deploy.
HEALTH_URL=https://clickgraft.elusive.net/

# ntfy, for the visitor watcher (site/deploy/watch/). Use a WRITE-ONLY user:
# this password ends up on the web container, and a read-capable account
# there could subscribe to every topic on the server.
NTFY_URL=https://ntfy.example.com
NTFY_TOPIC=clickgraft
NTFY_USER=publisher
NTFY_PASS=

# Volume paths on the shared edge host.
LOG_VOL=/var/lib/docker/volumes/edge_logs/_data
REPORT_VOL=/var/lib/docker/volumes/edge_clickgraft_reports/_data

# Address prefixes that are OURS, so our own visits are not counted as other
# people's. Comma separated, truncated the same way the log truncates them
# (a.b.c.0). Leave empty and nothing is excluded.
#
# These are stated, not guessed: summary.sh classifies everyone else by
# user-agent precisely because guessing which address was ours was wrong for a
# day while travelling. Excluded hits are still reported, under their own line.
EXCLUDE_PREFIX=
