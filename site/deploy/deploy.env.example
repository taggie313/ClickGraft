# Where this site is deployed. Copy to deploy.env (gitignored) and fill in.
#
#   cp site/deploy/deploy.env.example site/deploy/deploy.env
#
# Kept out of git deliberately: the host and container id describe someone's
# private network and are no use to anyone else.

# SSH target for the Proxmox node hosting the CT. Deploys go THROUGH the node,
# never into the container.
PVE_HOST=root@your-pve-node

# LXC container id on that node.
CT_ID=117

# Project directory inside the container.
REMOTE_DIR=/opt/clickgraft

# Public URL, checked after every deploy.
HEALTH_URL=https://clickgraft.elusive.net/

# ntfy, for the visitor watcher (site/deploy/watch/). Use a WRITE-ONLY user:
# this password ends up on the web container, and a read-capable account
# there could subscribe to every topic on the server.
NTFY_URL=https://ntfy.example.com
NTFY_TOPIC=clickgraft
NTFY_USER=publisher
NTFY_PASS=
